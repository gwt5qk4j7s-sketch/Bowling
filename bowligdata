/* ── Export / Import Modal ── */
function DataModal({col,lineups,extra,onImport,onClose}){
  const[mode,setMode]=useState("export"); // "export"|"import"
  const[txt,setTxt]=useState("");
  const[msg,setMsg]=useState("");

  const exportData=()=>{
    const data={col:[...col],lineups,extra,ver:1,ts:Date.now()};
    const json=JSON.stringify(data);
    setTxt(json);
    if(navigator.clipboard){
      navigator.clipboard.writeText(json).then(()=>setMsg("✓ クリップボードにコピーしました")).catch(()=>setMsg("下のテキストをコピーしてください"));
    } else setMsg("下のテキストをコピーしてください");
  };

  const importData=()=>{
    try{
      const data=JSON.parse(txt);
      if(!data.ver)throw new Error("invalid");
      onImport(data);
      setMsg("✓ インポート完了");
    }catch{setMsg("⚠ データの形式が正しくありません");}
  };

  return(
    <div onClick={onClose} style={{position:"fixed",inset:0,background:"rgba(0,0,0,.88)",zIndex:500,display:"flex",alignItems:"flex-end"}}>
      <div onClick={e=>e.stopPropagation()} style={{background:"#0d1117",borderRadius:"18px 18px 0 0",width:"100%",maxHeight:"85vh",overflowY:"auto",paddingBottom:`max(20px,env(safe-area-inset-bottom))`}}>
        <div style={{width:36,height:4,background:"#334155",borderRadius:2,margin:"12px auto 8px"}}/>
        <div style={{padding:"0 18px 18px"}}>
          <div style={{fontSize:16,fontWeight:800,marginBottom:4}}>💾 データのバックアップ</div>
          <div style={{fontSize:12,color:"#64748b",marginBottom:16}}>データをテキストとして保存・復元できます</div>
          <div style={{display:"flex",gap:8,marginBottom:16}}>
            {[["export","📤 エクスポート"],["import","📥 インポート"]].map(([id,l])=>(
              <button key={id} onClick={()=>{setMode(id);setMsg("");setTxt("");}} style={{flex:1,padding:"11px",borderRadius:10,cursor:"pointer",fontSize:13,fontWeight:mode===id?700:400,background:mode===id?"#0f2147":"#1e293b",border:`1px solid ${mode===id?"#1d4ed8":"#334155"}`,color:mode===id?"#60a5fa":"#64748b"}}>
                {l}
              </button>
            ))}
          </div>
          {mode==="export"&&(
            <>
              <div style={{fontSize:12,color:"#64748b",marginBottom:10}}>
                現在のデータ：コレクション <b style={{color:"#f97316"}}>{col.size}個</b>、ラインナップ <b style={{color:"#38bdf8"}}>{lineups.length}件</b>
              </div>
              <button onClick={exportData} style={{width:"100%",padding:"13px",borderRadius:12,cursor:"pointer",background:"#1d4ed8",border:"none",color:"#fff",fontWeight:700,fontSize:15,marginBottom:12}}>
                データをコピー／表示する
              </button>
              {txt&&(
                <textarea readOnly value={txt} style={{width:"100%",padding:"10px",borderRadius:10,border:"1px solid #1e293b",background:"#080c14",color:"#94a3b8",fontSize:10,height:120,fontFamily:"monospace",resize:"none"}}/>
              )}
            </>
          )}
          {mode==="import"&&(
            <>
              <div style={{fontSize:12,color:"#64748b",marginBottom:10}}>
                エクスポートしたテキストをここに貼り付けてください
              </div>
              <textarea value={txt} onChange={e=>setTxt(e.target.value)} placeholder="ここにバックアップデータを貼り付け…"
                style={{width:"100%",padding:"10px",borderRadius:10,border:"1px solid #1e293b",background:"#080c14",color:"#f1f5f9",fontSize:11,height:120,fontFamily:"monospace",resize:"none",marginBottom:12}}/>
              <button onClick={importData} style={{width:"100%",padding:"13px",borderRadius:12,cursor:"pointer",background:txt?"#f97316":"#334155",border:"none",color:txt?"#000":"#475569",fontWeight:700,fontSize:15}}>
                データを復元する
              </button>
            </>
          )}
          {msg&&<div style={{marginTop:12,padding:"10px",borderRadius:8,background:msg.startsWith("✓")?"#14532d":"#450a0a",color:msg.startsWith("✓")?"#22c55e":"#ef4444",fontSize:13,textAlign:"center"}}>{msg}</div>}
        </div>
      </div>
    </div>
  );
}


function App(){
  const[extra,setExtra]=useState([]);
  const[col,setCol]=useState(new Set());
  const[lineups,setLineups]=useState([]);
  const[tab,setTab]=useState("db");
  const[filter,setFilter]=useState({brand:"All",ct:"All",cT:"All",search:""});
  const[sort,setSort]=useState({field:"date",dir:"desc"});
  const[detail,setDetail]=useState(null);
  const[lModal,setLModal]=useState(false);
  const[editIdx,setEditIdx]=useState(null);
  const[initForm,setInitForm]=useState({name:"",condition:"",notes:"",balls:[]});
  const[aiQ,setAiQ]=useState("");
  const[aiLoad,setAiLoad]=useState(false);
  const[toast,setToast]=useState("");
  const[lSub,setLSub]=useState({});
  const[filterOpen,setFilterOpen]=useState(false);
  const[dataModal,setDataModal]=useState(false);
  const[saveStatus,setSaveStatus]=useState("idle");
  const showToast=(m,ms=2500)=>{setToast(m);setTimeout(()=>setToast(""),ms);};

  useEffect(()=>{
    (async()=>{
      try{
        const c=await LS.get("ba_col");if(c)setCol(new Set(JSON.parse(c.value)));
        const l=await LS.get("ba_lin");if(l)setLineups(JSON.parse(l.value));
        const x=await LS.get("ba_ext");if(x){setExtra(JSON.parse(x.value));}
      }catch(e){console.warn("Load error",e);}
    })();
  },[]);

  const allBalls=[...BALLS,...extra];

  const saveCol=async s=>{
    setCol(s);
    setSaveStatus("saving");
    try{
      await LS.set("ba_col",JSON.stringify([...s]));
      setSaveStatus("saved");
      setTimeout(()=>setSaveStatus("idle"),1500);
    }catch(e){setSaveStatus("error");showToast("⚠ 保存に失敗しました。エクスポートでバックアップしてください");}
  };
  const saveLin=async a=>{
    setLineups(a);
    setSaveStatus("saving");
    try{
      await LS.set("ba_lin",JSON.stringify(a));
      setSaveStatus("saved");
      setTimeout(()=>setSaveStatus("idle"),1500);
      showToast("保存しました ✓");
    }catch(e){setSaveStatus("error");showToast("⚠ 保存失敗 — エクスポートでバックアップを");}
  };
  const toggleOwn=id=>{const s=new Set(col);s.has(id)?s.delete(id):s.add(id);saveCol(s);};

  const handleImport=async data=>{
    try{
      if(data.col){const s=new Set(data.col);setCol(s);await LS.set("ba_col",JSON.stringify(data.col));}
      if(data.lineups){setLineups(data.lineups);await LS.set("ba_lin",JSON.stringify(data.lineups));}
      if(data.extra){setExtra(data.extra);await LS.set("ba_ext",JSON.stringify(data.extra));}
      showToast("✓ インポート完了");
      setDataModal(false);
    }catch{showToast("⚠ インポートエラー");}
  };

  /* AI search */
  const doAI=async()=>{
    if(!aiQ.trim()||aiLoad)return;
    setAiLoad(true);
    try{
      const resp=await fetch("https://api.anthropic.com/v1/messages",{
        method:"POST",headers:{"Content-Type":"application/json"},
        body:JSON.stringify({model:"claude-sonnet-4-20250514",max_tokens:2000,
          tools:[{type:"web_search_20250305",name:"web_search"}],
          system:`Search bowwwl.com for bowling balls. Return ONLY raw JSON array. Each object: {"brand":"","bS":"url-slug","name":"","slug":"","img":"brand-ball-slug","date":"YYYY-MM","cover":"","ct":"Solid|Pearl|Hybrid|Urethane|NU|MCP|Polyester|Particle","finish":"","core":"","cT":"Symmetric|Asymmetric","rg":2.480,"diff":0.050,"mb":null}. Return [] if nothing found.`,
          messages:[{role:"user",content:`Search bowwwl.com: "${aiQ}". Return JSON.`}]
        })
      });
      const data=await resp.json();
      const text=(data.content||[]).filter(c=>c.type==="text").map(c=>c.text).join("");
      const m=text.match(/\[[\s\S]*\]/);
      if(m){
        const fresh=JSON.parse(m[0]);
        if(fresh.length){
          const maxId=Math.max(...allBalls.map(b=>b.id),999);
          const tagged=fresh.map((b,i)=>({...b,id:maxId+i+1}));
          setExtra(prev=>{
            const names=new Set(allBalls.map(b=>`${b.brand}:${b.name}`));
            const added=tagged.filter(b=>!names.has(`${b.brand}:${b.name}`));
            const next=[...prev,...added];
            LS.set("ba_ext",JSON.stringify(next));
            return next;
          });
          showToast(`${tagged.length}件追加しました`);
        }else showToast("見つかりませんでした");
      }
    }catch{showToast("検索エラー");}
    setAiLoad(false);
  };

  /* Filter / Sort */
  const ALL_BRANDS=["All",...[...new Set(allBalls.map(b=>b.brand))].sort()];
  const displayed=allBalls.filter(b=>{
    if(filter.brand!=="All"&&b.brand!==filter.brand)return false;
    if(filter.ct!=="All"&&b.ct!==filter.ct)return false;
    if(filter.cT!=="All"&&b.cT!==filter.cT)return false;
    if(filter.search){const q=filter.search.toLowerCase();if(!`${b.brand} ${b.name} ${b.cover} ${b.core}`.toLowerCase().includes(q))return false;}
    return true;
  }).sort((a,b)=>{
    const d=sort.dir==="asc"?1:-1;
    if(sort.field==="date")return(a.date>b.date?1:-1)*d;
    if(sort.field==="name")return a.name.localeCompare(b.name)*d;
    if(sort.field==="rg")return(a.rg-b.rg)*d;
    if(sort.field==="diff")return(a.diff-b.diff)*d;
    return 0;
  });
  const onSort=f=>setSort(s=>s.field===f?{...s,dir:s.dir==="asc"?"desc":"asc"}:{field:f,dir:"desc"});
  const owned=allBalls.filter(b=>col.has(b.id));
  const openNew=()=>{setInitForm({name:"",condition:"",notes:"",balls:[]});setEditIdx(null);setLModal(true);};
  const openEdit=idx=>{setInitForm({...lineups[idx]});setEditIdx(idx);setLModal(true);};
  const onSave=form=>{const next=editIdx!=null?lineups.map((l,i)=>i===editIdx?{...form}:l):[...lineups,{...form}];saveLin(next);setLModal(false);};
  const getSub=(idx)=>lSub[idx]||"chart";
  const setSub=(idx,v)=>setLSub(s=>({...s,[idx]:v}));

  /* ── Renders ── */
  const renderDB=()=>(
    <div style={{flex:1,display:"flex",flexDirection:"column",overflow:"hidden"}}>
      {/* Search bar */}
      <div style={{padding:"10px 14px 6px",background:"#060a12",borderBottom:"1px solid #0f1e35"}}>
        <div style={{display:"flex",gap:8,marginBottom:8}}>
          <input value={filter.search} onChange={e=>setFilter(f=>({...f,search:e.target.value}))}
            placeholder="🔍 ボール名 / カバー / コアで検索"
            style={{flex:1,padding:"10px 12px",borderRadius:10,border:"1px solid #1e293b",background:"#0d1117",color:"#f1f5f9",fontSize:14}}/>
          <button onClick={()=>setFilterOpen(v=>!v)} style={{padding:"10px 14px",borderRadius:10,background:filterOpen?"#f97316":"#1e293b",border:"none",color:filterOpen?"#000":"#94a3b8",fontSize:13,whiteSpace:"nowrap",cursor:"pointer"}}>
            フィルタ
          </button>
        </div>
        {filterOpen&&(
          <div style={{display:"flex",gap:8,flexWrap:"wrap",paddingBottom:4}}>
            {[["brand",ALL_BRANDS,"ブランド"],["ct",ALL_CT_LIST,"カバー"],["cT",ALL_CORE_LIST,"コア"]].map(([k,opts,label])=>(
              <select key={k} value={filter[k]} onChange={e=>setFilter(f=>({...f,[k]:e.target.value}))}
                style={{padding:"8px 10px",borderRadius:8,border:"1px solid #1e293b",background:"#0d1117",color:"#94a3b8",fontSize:12,flex:1,minWidth:90}}>
                <option value="All">全{label}</option>
                {opts.slice(1).map(o=><option key={o}>{o}</option>)}
              </select>
            ))}
          </div>
        )}
        <div style={{display:"flex",gap:8}}>
          <input value={aiQ} onChange={e=>setAiQ(e.target.value)} onKeyDown={e=>e.key==="Enter"&&doAI()}
            placeholder="AI検索でボール追加…"
            style={{flex:1,padding:"9px 12px",borderRadius:10,border:"1px solid #1e293b",background:"#0d1117",color:"#f1f5f9",fontSize:13}}/>
          <button onClick={doAI} disabled={aiLoad} style={{padding:"9px 14px",borderRadius:10,background:aiLoad?"#1e293b":"#f97316",border:"none",color:aiLoad?"#475569":"#000",fontWeight:700,fontSize:12,whiteSpace:"nowrap",cursor:"pointer"}}>
            {aiLoad?"…":"AI検索"}
          </button>
        </div>
        <div style={{fontSize:11,color:"#334155",marginTop:6,textAlign:"center"}}>{displayed.length}件 / 計{allBalls.length}球</div>
      </div>
      {/* Ball list */}
      <div className="scroll" style={{flex:1,padding:"8px 14px"}}>
        {displayed.map(ball=>{
          const own=col.has(ball.id);
          return(
            <div key={ball.id} onClick={()=>setDetail(ball)}
              style={{display:"flex",alignItems:"center",gap:12,padding:"10px 12px",borderRadius:12,marginBottom:8,cursor:"pointer",background:own?"#0b1525":"#0d1117",border:`1px solid ${own?"#1e3a5f":"#1e293b"}`}}>
              <BallImg ball={ball} size={50}/>
              <div style={{flex:1,minWidth:0}}>
                <div style={{fontSize:10,color:"#334155",fontFamily:"monospace",marginBottom:1}}>{ball.brand} · {ball.date}</div>
                <div style={{fontSize:14,fontWeight:700,color:own?"#93c5fd":"#f1f5f9",overflow:"hidden",textOverflow:"ellipsis",whiteSpace:"nowrap",marginBottom:5}}>{ball.name}</div>
                <div style={{display:"flex",gap:5,flexWrap:"wrap"}}>
                  <CTBadge ct={ball.ct} small/>
                  <CoreBadge cT={ball.cT} small/>
                  <span style={{fontSize:9,fontFamily:"monospace",color:"#38bdf8"}}>RG {ball.rg}</span>
                  <span style={{fontSize:9,fontFamily:"monospace",color:"#a78bfa"}}>{ball.diff}</span>
                </div>
              </div>
              <button onClick={e=>{e.stopPropagation();toggleOwn(ball.id);}} style={{padding:"7px 12px",borderRadius:8,border:`1px solid ${own?"#1d4ed8":"#334155"}`,background:own?"#1d4ed820":"transparent",color:own?"#60a5fa":"#475569",fontSize:11,cursor:"pointer",whiteSpace:"nowrap",flexShrink:0}}>
                {own?"✓ 所持":"＋"}
              </button>
            </div>
          );
        })}
        {displayed.length===0&&<div style={{textAlign:"center",padding:"60px 20px",color:"#334155"}}><div style={{fontSize:36,marginBottom:12}}>🔍</div>該当なし</div>}
        <div style={{height:90}}/>
      </div>
    </div>
  );

  const renderCol=()=>(
    <div style={{flex:1,display:"flex",flexDirection:"column",overflow:"hidden"}}>
      <div style={{padding:"10px 14px 8px",background:"#060a12",borderBottom:"1px solid #0f1e35"}}>
        <div style={{display:"flex",gap:8,flexWrap:"wrap"}}>
          {Object.keys(CT).map(t=>{const n=owned.filter(b=>b.ct===t).length;if(!n)return null;
            return(<div key={t} style={{display:"flex",alignItems:"center",gap:5,padding:"4px 10px",borderRadius:20,background:ctB(t),border:`1px solid ${ctC(t)}40`}}>
              <span style={{fontSize:10,color:ctC(t)}}>{t}</span>
              <span style={{fontSize:13,fontWeight:700,color:"#f1f5f9",fontFamily:"monospace"}}>{n}</span>
            </div>);
          })}
          <span style={{fontSize:11,color:"#475569",alignSelf:"center",marginLeft:"auto"}}>計{owned.length}個</span>
        </div>
      </div>
      <div className="scroll" style={{flex:1,padding:"8px 14px"}}>
        {owned.length===0
          ?<div style={{textAlign:"center",padding:"80px 20px",color:"#334155"}}><div style={{fontSize:48,marginBottom:14}}>🎳</div><div style={{fontSize:16,fontWeight:700,marginBottom:8}}>コレクションが空です</div><div style={{fontSize:13}}>「データベース」でボールを追加してください</div></div>
          :owned.map(ball=>(
            <div key={ball.id} onClick={()=>setDetail(ball)}
              style={{display:"flex",alignItems:"center",gap:12,padding:"10px 12px",borderRadius:12,marginBottom:8,cursor:"pointer",background:"#0b1525",border:"1px solid #1e3a5f"}}>
              <BallImg ball={ball} size={52}/>
              <div style={{flex:1,minWidth:0}}>
                <div style={{fontSize:10,color:"#334155",fontFamily:"monospace",marginBottom:1}}>{ball.brand}</div>
                <div style={{fontSize:14,fontWeight:700,color:"#f1f5f9",overflow:"hidden",textOverflow:"ellipsis",whiteSpace:"nowrap",marginBottom:5}}>{ball.name}</div>
                <div style={{display:"flex",gap:5,flexWrap:"wrap"}}>
                  <CTBadge ct={ball.ct} small/>
                  <CoreBadge cT={ball.cT} small/>
                  <span style={{fontSize:9,fontFamily:"monospace",color:"#38bdf8"}}>RG {ball.rg}</span>
                  <span style={{fontSize:9,fontFamily:"monospace",color:"#a78bfa"}}>{ball.diff}</span>
                  {ball.mb&&<span style={{fontSize:9,fontFamily:"monospace",color:"#f97316"}}>MB {ball.mb}</span>}
                </div>
              </div>
            </div>
          ))
        }
        <div style={{height:90}}/>
      </div>
    </div>
  );

  const renderLineups=()=>(
    <div style={{flex:1,display:"flex",flexDirection:"column",overflow:"hidden"}}>
      <div style={{padding:"10px 14px 8px",background:"#060a12",borderBottom:"1px solid #0f1e35",display:"flex",justifyContent:"space-between",alignItems:"center"}}>
        <span style={{fontSize:13,color:"#475569"}}>{lineups.length}件のラインナップ</span>
        <button onClick={openNew} style={{padding:"9px 16px",borderRadius:10,background:"#f97316",border:"none",color:"#000",fontWeight:700,fontSize:13,cursor:"pointer"}}>＋ 新規</button>
      </div>
      <div className="scroll" style={{flex:1,padding:"8px 14px"}}>
        {lineups.length===0
          ?<div style={{textAlign:"center",padding:"80px 20px",color:"#334155"}}><div style={{fontSize:48,marginBottom:14}}>📋</div><div style={{fontSize:16,fontWeight:700,marginBottom:8}}>ラインナップがありません</div><div style={{fontSize:13}}>「＋ 新規」から作成してください</div></div>
          :lineups.map((lin,idx)=>{
            const linBalls=lin.balls.map(id=>allBalls.find(b=>b.id===id)).filter(Boolean);
            const sub=getSub(idx);
            return(
              <div key={idx} style={{background:"#0d1117",border:"1px solid #1e293b",borderRadius:14,marginBottom:12,overflow:"hidden"}}>
                <div style={{padding:"12px 14px",borderBottom:"1px solid #1e293b"}}>
                  <div style={{display:"flex",justifyContent:"space-between",alignItems:"flex-start",gap:10}}>
                    <div style={{flex:1,minWidth:0}}>
                      <div style={{fontSize:16,fontWeight:700,color:"#f1f5f9",marginBottom:2}}>{lin.name}</div>
                      {lin.condition&&<div style={{fontSize:11,color:"#64748b"}}>🏟 {lin.condition}</div>}
                      {lin.notes&&<div style={{fontSize:11,color:"#475569",marginTop:2,whiteSpace:"pre-wrap"}}>{lin.notes}</div>}
                      <div style={{display:"flex",gap:4,marginTop:6,flexWrap:"wrap"}}>
                        {[...new Set(linBalls.map(b=>b.ct))].map(t=><CTBadge key={t} ct={t} small/>)}
                        <span style={{fontSize:10,color:"#334155",alignSelf:"center"}}>{linBalls.length}球</span>
                      </div>
                    </div>
                    <div style={{display:"flex",gap:6,flexShrink:0}}>
                      <button onClick={()=>openEdit(idx)} style={{padding:"6px 11px",borderRadius:8,cursor:"pointer",background:"#1e293b",border:"none",color:"#94a3b8",fontSize:12}}>編集</button>
                      <button onClick={()=>{if(confirm("削除しますか？"))saveLin(lineups.filter((_,i)=>i!==idx));}} style={{padding:"6px 11px",borderRadius:8,cursor:"pointer",background:"#1e293b",border:"none",color:"#ef4444",fontSize:12}}>削除</button>
                    </div>
                  </div>
                </div>
                {linBalls.length===0
                  ?<div style={{padding:"16px",color:"#334155",textAlign:"center",fontSize:13}}>ボールが選択されていません</div>
                  :<div style={{padding:"12px 14px"}}>
                    {/* Sub tabs */}
                    <div style={{display:"flex",gap:6,marginBottom:12}}>
                      {[["chart","📊 グラフ"],["table","📋 比較表"],["balls","🎳 一覧"]].map(([id,l])=>(
                        <button key={id} onClick={()=>setSub(idx,id)} style={{flex:1,padding:"7px 4px",borderRadius:8,cursor:"pointer",fontSize:11,fontWeight:sub===id?700:400,background:sub===id?"#0f2147":"transparent",border:`1px solid ${sub===id?"#1d4ed8":"#1e293b"}`,color:sub===id?"#60a5fa":"#64748b"}}>
                          {l}
                        </button>
                      ))}
                    </div>
                    {sub==="chart"&&<ScatterChart balls={linBalls}/>}
                    {sub==="table"&&<CompareTable balls={linBalls}/>}
                    {sub==="balls"&&(
                      <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:8}}>
                        {linBalls.map(ball=>(
                          <div key={ball.id} onClick={()=>setDetail(ball)} style={{background:"#080c14",border:"1px solid #1e293b",borderRadius:10,padding:"10px",cursor:"pointer",display:"flex",gap:8,alignItems:"center"}}>
                            <BallImg ball={ball} size={44}/>
                            <div style={{minWidth:0}}>
                              <div style={{fontSize:9,color:"#334155",fontFamily:"monospace"}}>{ball.brand}</div>
                              <div style={{fontSize:12,fontWeight:600,color:"#f1f5f9",overflow:"hidden",textOverflow:"ellipsis",whiteSpace:"nowrap"}}>{ball.name}</div>
                              <CTBadge ct={ball.ct} small/>
                              <div style={{fontSize:10,color:"#475569",fontFamily:"monospace",marginTop:2}}>{ball.rg}/{ball.diff}</div>
                            </div>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                }
              </div>
            );
          })
        }
        <div style={{height:90}}/>
      </div>
    </div>
  );

  /* ── Bottom Nav ── */
  const NAV=[
    {id:"db",icon:"🗄",label:"データベース"},
    {id:"col",icon:"🎳",label:"コレクション"},
    {id:"lin",icon:"📋",label:"ラインナップ"},
  ];

  return(
    <div style={{height:"100%",display:"flex",flexDirection:"column",background:"#080c14"}}>
      {/* Header */}
      <div style={{background:"#040710",borderBottom:"1px solid #0f1e35",padding:`${window.innerHeight>700?"10px":"7px"} 16px`,paddingTop:`max(10px,env(safe-area-inset-top))`,display:"flex",alignItems:"center",justifyContent:"space-between",flexShrink:0}}>
        <div style={{display:"flex",alignItems:"center",gap:10}}>
          <span style={{fontSize:22}}>🎳</span>
          <div>
            <div style={{fontSize:14,fontWeight:700,letterSpacing:-.5,fontFamily:"monospace",lineHeight:1}}>BOWLING ARSENAL</div>
            <div style={{fontSize:8,color:"#334155",letterSpacing:2,textTransform:"uppercase"}}>bowwwl.com · {allBalls.length} balls</div>
          </div>
        </div>
        <div style={{display:"flex",gap:10,alignItems:"center"}}>
          {saveStatus==="saving"&&<span style={{fontSize:10,color:"#f59e0b"}}>保存中…</span>}
          {saveStatus==="saved"&&<span style={{fontSize:10,color:"#22c55e"}}>✓ 保存済</span>}
          {saveStatus==="error"&&<span style={{fontSize:10,color:"#ef4444"}}>✗ 保存失敗</span>}
          <button onClick={()=>setDataModal(true)} style={{padding:"6px 10px",borderRadius:8,background:"#1e293b",border:"1px solid #334155",color:"#94a3b8",fontSize:11,cursor:"pointer"}}>💾 バックアップ</button>
          <div style={{display:"flex",gap:10}}>
            {[["所持",`${col.size}`,`#f97316`],["ライン",`${lineups.length}`,`#38bdf8`]].map(([k,v,c])=>(
              <div key={k} style={{textAlign:"center"}}>
                <div style={{fontSize:8,color:"#334155",letterSpacing:1}}>{k}</div>
                <div style={{fontWeight:700,color:c,fontFamily:"monospace",fontSize:14}}>{v}</div>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* Toast */}
      {toast&&(
        <div style={{position:"fixed",top:70,left:"50%",transform:"translateX(-50%)",zIndex:500,background:"#14532d",border:"1px solid #15803d",color:"#22c55e",fontSize:12,padding:"8px 16px",borderRadius:20,whiteSpace:"nowrap"}}>
          {toast}
        </div>
      )}

      {/* Content */}
      <div style={{flex:1,display:"flex",flexDirection:"column",overflow:"hidden"}}>
        {tab==="db"&&renderDB()}
        {tab==="col"&&renderCol()}
        {tab==="lin"&&renderLineups()}
      </div>

      {/* Bottom Nav */}
      <div style={{background:"#040710",borderTop:"1px solid #0f1e35",display:"flex",paddingBottom:`env(safe-area-inset-bottom)`,flexShrink:0}}>
        {NAV.map(({id,icon,label})=>(
          <button key={id} onClick={()=>setTab(id)} style={{flex:1,padding:"10px 4px 8px",background:"transparent",border:"none",cursor:"pointer",display:"flex",flexDirection:"column",alignItems:"center",gap:3}}>
            <span style={{fontSize:22,lineHeight:1}}>{icon}</span>
            <span style={{fontSize:9,fontWeight:tab===id?700:400,color:tab===id?"#f97316":"#475569",letterSpacing:.3}}>{label}</span>
            {tab===id&&<div style={{width:20,height:2,background:"#f97316",borderRadius:1}}/>}
          </button>
        ))}
      </div>

      {/* Modals */}
      {detail&&<DetailModal ball={detail} collection={col} onToggle={toggleOwn} onClose={()=>setDetail(null)}/>}
      {lModal&&<LineupModal owned={owned} editIdx={editIdx} initForm={initForm} onSave={onSave} onClose={()=>setLModal(false)} allBalls={allBalls}/>}
      {dataModal&&<DataModal col={col} lineups={lineups} extra={extra} onImport={handleImport} onClose={()=>setDataModal(false)}/>}
    </div>
  );
}

ReactDOM.createRoot(document.getElementById('root')).render(<App/>);
</script>
</body>
</html>
