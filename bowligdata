/* ── Storage: IndexedDB primary, localStorage fallback ── */
const DB_NAME="BowlingArsenal",DB_VER=1,STORE="kv";
let _db=null;
function openDB(){
  if(_db)return Promise.resolve(_db);
  return new Promise((res,rej)=>{
    const req=indexedDB.open(DB_NAME,DB_VER);
    req.onupgradeneeded=e=>{e.target.result.createObjectStore(STORE);};
    req.onsuccess=e=>{_db=e.target.result;res(_db);};
    req.onerror=()=>rej(req.error);
  });
}
const IDB={
  get:async k=>{
    try{
      const db=await openDB();
      return new Promise((res,rej)=>{
        const tx=db.transaction(STORE,"readonly");
        const req=tx.objectStore(STORE).get(k);
        req.onsuccess=()=>res(req.result!=null?{value:req.result}:null);
        req.onerror=()=>rej(req.error);
      });
    }catch{
      try{const v=localStorage.getItem(k);return v?{value:v}:null;}catch{return null;}
    }
  },
  set:async(k,v)=>{
    try{
      const db=await openDB();
      await new Promise((res,rej)=>{
        const tx=db.transaction(STORE,"readwrite");
        const req=tx.objectStore(STORE).put(v,k);
        req.onsuccess=()=>res();
        req.onerror=()=>rej(req.error);
      });
    }catch{}
    try{localStorage.setItem(k,v);}catch{}
  },
};
