/* ── Mini Components ── */
function BallImg({ball,size=44}){
  const[e,setE]=useState(false);
  return e
    ?<div style={{width:size,height:size,borderRadius:size/2,background:"#1e293b",display:"flex",alignItems:"center",justifyContent:"center",fontSize:size*.38,flexShrink:0}}>🎳</div>
    :<img src={THUMB(ball.img)} alt={ball.name} onError={()=>setE(true)} style={{width:size,height:size,objectFit:"contain",flexShrink:0}}/>;
}
function BrandLogo({brand,size=20}){
  const[e,setE]=useState(false);
  const f=BRAND_LOGOS[brand];
  if(!f||e) return <span style={{fontSize:9,color:"#475569",fontWeight:600}}>{brand}</span>;
  return <img src={LOGO(f)} alt={brand} onError={()=>setE(true)} style={{height:size,maxWidth:64,objectFit:"contain",filter:"brightness(0) invert(.55)"}}/>;
}
function CTBadge({ct,small}){
  return <span style={{fontSize:small?9:10,padding:small?"1px 6px":"2px 8px",borderRadius:20,background:ctB(ct),color:ctC(ct),border:`1px solid ${ctC(ct)}40`,whiteSpace:"nowrap"}}>{ct}</span>;
}
function CoreBadge({cT,small}){
  const asym=cT==="Asymmetric";
  return <span style={{fontSize:small?9:10,padding:small?"1px 6px":"2px 8px",borderRadius:20,background:asym?"#2e1065":"#042f2e",color:asym?"#a78bfa":"#2dd4bf",whiteSpace:"nowrap"}}>{asym?"非対称":"対称"}</span>;
}

/* ── Scatter Chart (fixed axes) ── */
function ScatterChart({balls}){
  const[hov,setHov]=useState(null);
  const ref=useRef(null);
  const[w,setW]=useState(320);
  useEffect(()=>{
    const obs=new ResizeObserver(en=>setW(Math.max(300,en[0].contentRect.width)));
    if(ref.current)obs.observe(ref.current);
    return()=>obs.disconnect();
  },[]);
  const h=Math.max(260,w*0.68);
  const PAD={t:16,r:58,b:52,l:46};
  const PW=w-PAD.l-PAD.r,PH=h-PAD.t-PAD.b;
  const xP=d=>PAD.l+(d-X_MIN)/(X_MAX-X_MIN)*PW;
  const yP=r=>PAD.t+(Y_MAX-r)/(Y_MAX-Y_MIN)*PH;
  const rgHue=r=>{const t=(r-Y_MIN)/(Y_MAX-Y_MIN);return `hsl(${Math.round(t*220)},90%,60%)`;};
  const BR=Math.max(15,Math.min(24,PW/(Math.max(balls.length,1)*1.8)));
  const hovBall=hov?balls.find(b=>b.id===hov):null;

  return(
    <div ref={ref} style={{width:"100%"}}>
      <svg width={w} height={h} style={{display:"block",background:"#04060e",borderRadius:10}}>
        <defs>
          <linearGradient id="cbar2" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stopColor="#3b82f6"/>
            <stop offset="50%" stopColor="#22c55e"/>
            <stop offset="80%" stopColor="#f59e0b"/>
            <stop offset="100%" stopColor="#ef4444"/>
          </linearGradient>
          <clipPath id="pc2"><rect x={PAD.l} y={PAD.t} width={PW} height={PH}/></clipPath>
        </defs>
        <rect x={PAD.l} y={PAD.t} width={PW} height={PH} fill="#060a14" rx={3}/>
        {X_TICKS.map(v=><line key={v} x1={xP(v)} x2={xP(v)} y1={PAD.t} y2={PAD.t+PH} stroke="#0f1e35" strokeWidth={1}/>)}
        {Y_TICKS.map(v=><line key={v} x1={PAD.l} x2={PAD.l+PW} y1={yP(v)} y2={yP(v)} stroke="#0f1e35" strokeWidth={1}/>)}
        {X_TICKS.filter((_,i)=>i%2===0).map(v=>(
          <text key={v} x={xP(v)} y={PAD.t+PH+13} textAnchor="middle" fill="#334155" fontSize={8} fontFamily="monospace">{v.toFixed(3)}</text>
        ))}
        {Y_TICKS.filter((_,i)=>i%2===0).map(v=>(
          <text key={v} x={PAD.l-5} y={yP(v)+3} textAnchor="end" fill="#334155" fontSize={8} fontFamily="monospace">{v.toFixed(2)}</text>
        ))}
        <text x={PAD.l} y={h-4} fill="#38bdf8" fontSize={9} fontWeight={600}>スムーズ</text>
        <text x={PAD.l+PW} y={h-4} textAnchor="end" fill="#ef4444" fontSize={9} fontWeight={600}>ストロング</text>
        <text x={9} y={PAD.t+PH/2} textAnchor="middle" fill="#475569" fontSize={9} transform={`rotate(-90,9,${PAD.t+PH/2})`}>RG</text>
        <rect x={w-PAD.r+14} y={PAD.t} width={8} height={PH} fill="url(#cbar2)" rx={2}/>
        <text x={w-PAD.r+18} y={PAD.t-3} textAnchor="middle" fill="#3b82f6" fontSize={7}>レイト</text>
        <text x={w-PAD.r+18} y={PAD.t+PH+10} textAnchor="middle" fill="#ef4444" fontSize={7}>アーリー</text>
        <rect x={PAD.l} y={PAD.t} width={PW} height={PH} fill="none" stroke="#1e293b" strokeWidth={1} rx={3}/>
        {balls.map(ball=>{
          if(ball.diff<X_MIN||ball.diff>X_MAX||ball.rg<Y_MIN||ball.rg>Y_MAX)return null;
          const cx=xP(ball.diff),cy=yP(ball.rg),isH=hov===ball.id;
          return(
            <g key={ball.id} clipPath="url(#pc2)" onClick={()=>setHov(isH?null:ball.id)} style={{cursor:"pointer"}}>
              {isH&&<circle cx={cx} cy={cy} r={BR+6} fill="none" stroke={rgHue(ball.rg)} strokeWidth={2} opacity={0.9}/>}
              <circle cx={cx} cy={cy} r={BR+2} fill={rgHue(ball.rg)} opacity={0.2}/>
              <clipPath id={`bc2_${ball.id}`}><circle cx={cx} cy={cy} r={BR}/></clipPath>
              <image href={THUMB(ball.img)} x={cx-BR} y={cy-BR} width={BR*2} height={BR*2} clipPath={`url(#bc2_${ball.id})`} preserveAspectRatio="xMidYMid meet"/>
              <circle cx={cx} cy={cy} r={BR} fill="none" stroke={isH?rgHue(ball.rg):"rgba(255,255,255,0.18)"} strokeWidth={isH?2:1}/>
            </g>
          );
        })}
        {hovBall&&(()=>{
          const cx=xP(hovBall.diff),cy=yP(hovBall.rg),tw=140,th=60;
          const tx=cx+BR+6+tw>w-PAD.r?cx-BR-6-tw:cx+BR+6;
          const ty=Math.max(PAD.t,Math.min(PAD.t+PH-th,cy-th/2));
          return(
            <g>
              <rect x={tx} y={ty} width={tw} height={th} rx={5} fill="#0d1117" stroke="#1e293b" strokeWidth={1}/>
              <text x={tx+7} y={ty+13} fill="#f1f5f9" fontSize={10} fontWeight={700}>{hovBall.name}</text>
              <text x={tx+7} y={ty+24} fill="#64748b" fontSize={8}>{hovBall.brand}</text>
              <text x={tx+7} y={ty+37} fill="#38bdf8" fontSize={8} fontFamily="monospace">RG {hovBall.rg.toFixed(3)}</text>
              <text x={tx+7} y={ty+49} fill="#a78bfa" fontSize={8} fontFamily="monospace">ΔRG {hovBall.diff.toFixed(3)}{hovBall.mb?`  MB ${hovBall.mb.toFixed(3)}`:""}</text>
            </g>
          );
        })()}
      </svg>
      <div style={{display:"flex",gap:10,marginTop:6,flexWrap:"wrap",fontSize:10,color:"#334155",padding:"0 2px"}}>
        {[["高RG","#3b82f6"],["中RG","#22c55e"],["低RG","#ef4444"]].map(([l,c])=>(
          <span key={l} style={{display:"flex",alignItems:"center",gap:3}}><span style={{width:8,height:8,borderRadius:2,background:c,display:"inline-block"}}/>{l}</span>
        ))}
        <span style={{marginLeft:"auto",fontSize:9}}>ボールをタップで詳細</span>
      </div>
    </div>
  );
}

/* ── Compare Table ── */
function CompareTable({balls}){
  if(!balls.length)return null;
  const rows=[
    {k:"img",l:"",r:b=>(
      <div style={{display:"flex",flexDirection:"column",alignItems:"center",gap:3}}>
        <BallImg ball={b} size={50}/>
        <div style={{fontSize:9,color:"#94a3b8",fontWeight:700,textAlign:"center",lineHeight:1.2,maxWidth:120}}>{b.name}</div>
        <BrandLogo brand={b.brand} size={16}/>
      </div>
    )},
    {k:"date",l:"発売日",r:b=><span style={{fontFamily:"monospace",fontSize:10,color:"#64748b"}}>{b.date}</span>},
    {k:"ct",l:"カバー種別",r:b=><CTBadge ct={b.ct}/>},
    {k:"cover",l:"カバーストック",r:b=><span style={{fontSize:10,color:"#94a3b8",lineHeight:1.3}}>{b.cover}</span>},
    {k:"finish",l:"フィニッシュ",r:b=><span style={{fontSize:10,color:"#64748b"}}>{b.finish}</span>},
    {k:"cT",l:"コアタイプ",r:b=><CoreBadge cT={b.cT}/>},
    {k:"core",l:"コア名",r:b=><span style={{fontSize:10,color:"#94a3b8"}}>{b.core}</span>},
    {k:"rg",l:"RG",r:b=><span style={{fontFamily:"monospace",fontSize:16,fontWeight:800,color:"#38bdf8"}}>{b.rg.toFixed(3)}</span>},
    {k:"diff",l:"ΔRG",r:b=><span style={{fontFamily:"monospace",fontSize:16,fontWeight:800,color:"#a78bfa"}}>{b.diff.toFixed(3)}</span>},
    {k:"mb",l:"MB差分",r:b=>b.mb!=null?<span style={{fontFamily:"monospace",fontSize:14,fontWeight:700,color:"#f97316"}}>{b.mb.toFixed(3)}</span>:<span style={{color:"#334155"}}>—</span>},
    {k:"total",l:"RG+Diff",r:b=>{
      const v=b.rg+b.diff;
      const mn=Math.min(...balls.map(x=>x.rg+x.diff));
      const mx=Math.max(...balls.map(x=>x.rg+x.diff));
      const pct=mx===mn?0.5:(v-mn)/(mx-mn);
      return(<div><div style={{fontFamily:"monospace",fontSize:10,color:"#475569",marginBottom:3}}>{v.toFixed(3)}</div>
        <div style={{height:3,background:"#1e293b",borderRadius:2,width:60}}><div style={{height:"100%",width:`${pct*100}%`,background:`hsl(${Math.round((1-pct)*220)},90%,60%)`,borderRadius:2}}/></div></div>);
    }},
  ];
  return(
    <div className="hscroll" style={{borderRadius:10,border:"1px solid #1e293b"}}>
      <table style={{borderCollapse:"collapse",fontSize:12,minWidth:160+balls.length*140}}>
        <tbody>
          {rows.map(row=>(
            <tr key={row.k} style={{borderBottom:"1px solid #0f1420"}}>
              <td style={{padding:"8px 12px",background:"#060a12",color:"#475569",fontSize:10,fontWeight:600,letterSpacing:.5,textTransform:"uppercase",whiteSpace:"nowrap",position:"sticky",left:0,minWidth:80,borderRight:"1px solid #1e293b"}}>{row.l}</td>
              {balls.map(b=>(
                <td key={b.id} style={{padding:"8px 12px",background:"#0d1117",textAlign:"center",verticalAlign:"middle",minWidth:140,borderRight:"1px solid #0f1420"}}>{row.r(b)}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

